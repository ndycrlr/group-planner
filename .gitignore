node_modules/

# Claude Code checks worktrees out in here. Each one is a full working copy of
# this repo, so tracking it would commit the repository into itself.
.claude/worktrees/

*.db
*.db-journal
*.db-wal
*.db-shm

# Vercel
.vercel/
# `vercel link` writes a VERCEL_OIDC_TOKEN here, so this must never be tracked.
.env*

# Grilling hook
.grill-last-commit

# Playwright
.test-pending
.test-tmp/
test-results/
playwright-report/
blob-report/
playwright/.cache/
